auto eth0
iface eth0 inet static
    address 10.125.2.2
    netmask 255.255.255.0
    gateway 10.125.2.1
    up echo nameserver 192.168.122.1 > /etc/resolv.conf

auto eth1
iface eth1 inet static
    address 10.125.6.1
    netmask 255.255.255.0
    post-up ip route add 10.125.7.0/24 via 10.125.6.2
    pre-down ip route del 10.125.7.0/24 via 10.125.6.2

auto eth2
iface eth2 inet static
    address 10.125.5.1
    netmask 255.255.255.0