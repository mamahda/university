        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/mamahda/ontologies/2026/10/kasultanan-yogyakarta#Penguasa"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/mamahda/ontologies/2026/10/kasultanan-yogyakarta#Penguasa"/>
        <rdfs:comment xml:lang="id">Penerus takhta langsung (functional)</rdfs:comment>
    </owl:ObjectProperty>



    <!-- http://www.semanticweb.org/mamahda/ontologies/2026/10/kasultanan-yogyakarta#ibuDari -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/mamahda/ontologies/2026/10/kasultanan-yogyakarta#ibuDari">
