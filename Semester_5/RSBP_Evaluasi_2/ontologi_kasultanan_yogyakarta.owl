    <owl:Ontology rdf:about="http://www.semanticweb.org/mamahda/ontologies/2026/10/kasultanan-yogyakarta">
        <rdfs:label xml:lang="id">Ontologi Silsilah Kasultanan Ngayogyakarta Hadiningrat</rdfs:label>
        <rdfs:comment xml:lang="id">Silsilah Sultan Hamengku Buwono I sampai Hamengku Bawono Ka 10. Sumber utama: https://www.kratonjogja.id/</rdfs:comment>
    </owl:Ontology>


