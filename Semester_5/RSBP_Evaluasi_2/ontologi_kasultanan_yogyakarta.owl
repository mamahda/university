        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/mamahda/ontologies/2026/10/kasultanan-yogyakarta#Perempuan"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/mamahda/ontologies/2026/10/kasultanan-yogyakarta#Orang"/>
        <rdfs:comment xml:lang="id">Inverse punyaIbu: seorang anak menentukan tepat satu ibu (inverse functional)</rdfs:comment>
    </owl:ObjectProperty>



    <!-- http://www.semanticweb.org/mamahda/ontologies/2026/10/kasultanan-yogyakarta#istri -->

