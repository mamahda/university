        <rdfs:comment xml:lang="id">Setiap orang hanya punya satu ayah (functional)</rdfs:comment>
    </owl:ObjectProperty>



    <!-- http://www.semanticweb.org/mamahda/ontologies/2026/10/kasultanan-yogyakarta#punyaIbu -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/mamahda/ontologies/2026/10/kasultanan-yogyakarta#punyaIbu">
