        <rdfs:range rdf:resource="http://www.semanticweb.org/mamahda/ontologies/2026/10/kasultanan-yogyakarta#Orang"/>
        <rdfs:comment xml:lang="id">Orang tua langsung</rdfs:comment>
    </owl:ObjectProperty>



    <!-- http://www.semanticweb.org/mamahda/ontologies/2026/10/kasultanan-yogyakarta#suami -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/mamahda/ontologies/2026/10/kasultanan-yogyakarta#suami">
