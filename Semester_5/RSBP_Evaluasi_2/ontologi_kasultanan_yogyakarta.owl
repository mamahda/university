        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/mamahda/ontologies/2026/10/kasultanan-yogyakarta#Orang"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/mamahda/ontologies/2026/10/kasultanan-yogyakarta#Orang"/>
        <rdfs:comment xml:lang="id">x punyaLeluhur y: y adalah leluhur x (transitif)</rdfs:comment>
    </owl:ObjectProperty>



    <!-- http://www.semanticweb.org/mamahda/ontologies/2026/10/kasultanan-yogyakarta#punyaOrangTua -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/mamahda/ontologies/2026/10/kasultanan-yogyakarta#punyaOrangTua">
