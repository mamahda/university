    <!-- http://www.semanticweb.org/mamahda/ontologies/2026/10/kasultanan-yogyakarta#ayahDari -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/mamahda/ontologies/2026/10/kasultanan-yogyakarta#ayahDari">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/mamahda/ontologies/2026/10/kasultanan-yogyakarta#punyaAnak"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/mamahda/ontologies/2026/10/kasultanan-yogyakarta#LakiLaki"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/mamahda/ontologies/2026/10/kasultanan-yogyakarta#Orang"/>
        <rdfs:comment xml:lang="id">Inverse punyaAyah: seorang anak menentukan tepat satu ayah (inverse functional)</rdfs:comment>
    </owl:ObjectProperty>



    <!-- http://www.semanticweb.org/mamahda/ontologies/2026/10/kasultanan-yogyakarta#digantikanOleh -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/mamahda/ontologies/2026/10/kasultanan-yogyakarta#digantikanOleh">
